# Cloudflare Pages local-development variables for /functions/api/contact.js.
# In production, set these as encrypted secrets in Cloudflare Pages > Settings > Variables and Secrets.
# The API token needs the account-level "Email Sending: Edit" permission.
CLOUDFLARE_ACCOUNT_ID=your-cloudflare-account-id
CLOUDFLARE_EMAIL_API_TOKEN=your-cloudflare-email-sending-api-token
CONTACT_EMAIL_FROM=contact@playasdiamanteresidencial.com
CONTACT_EMAIL_TO=ventas@example.com
